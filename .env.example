# Токен Telegram-бота от @BotFather. Бот должен быть администратором каждого
# канала-источника. В каждом канале назначения ему нужно право публикации.
TELEGRAM_BOT_TOKEN=
# Токен бота MAX. Дайте ему права чтения в каналах-источниках и публикации
# в каналах назначения.
MAX_BOT_TOKEN=

# Для маршрутов MAX → Telegram. См. настройку HTTPS в README.
# MAX_WEBHOOK_URL=https://example.com/perepost/max
# MAX_WEBHOOK_SECRET=сгенерируйте_через_openssl_rand_-hex_32
# Для приёма постов из Telegram по HTTPS. Без URL используется long polling.
# TELEGRAM_WEBHOOK_URL=https://example.com/perepost/telegram
# TELEGRAM_WEBHOOK_SECRET=сгенерируйте_отдельный_секрет
# Общий слушатель двух вебхуков. В Docker можно указать 0.0.0.0:8090.
# WEBHOOK_LISTEN=127.0.0.1:8090
# В Docker и systemd путь к постоянной SQLite уже задан.
# STATE_FILE=/var/lib/perepost/perepost.sqlite

# Одна пара Telegram → MAX. Для обратного направления, нескольких каналов
# или синхронизации правок оставьте обе переменные пустыми и опишите
# маршруты в config/config.yaml по примеру config.example.yaml.
# Канал Telegram: https://t.me/name, @name или числовой id закрытого канала
TELEGRAM_CHANNEL=
# Канал MAX: числовой chat_id со знаком минус
MAX_CHANNEL=

# Необязательно. Числовой id пользователя Telegram, которому бот пишет о сбоях
# (узнать свой id: @userinfobot). Сначала откройте бота и нажмите «Старт».
TELEGRAM_ADMIN_ID=
# Необязательно. Адрес пульса: раз в 5 минут, если всё в порядке, бот шлёт сюда
# POST. Перестал приходить пульс — мониторинг поднимает тревогу
# (heartbeat-монитор GlitchTip, healthchecks.io и т. п.)
HEARTBEAT_URL=

# Необязательно: видео и файлы больше 20 МБ. Свой сервер Bot API из того же
# docker-compose.yml (см. README, «Видео больше 20 МБ»). api_id и api_hash —
# на my.telegram.org → API development tools.
# COMPOSE_PROFILES=bot-api
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# debug — подробный журнал
LOG_LEVEL=
